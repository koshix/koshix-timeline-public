{
  "name": "koshix-timeline",
  "private": true,
  "version": "2.9.17",
  "type": "module",
  "scripts": {
    "build:events": "node scripts/build-events.mjs",
    "dev": "vite",
    "build": "npm run build:events && vite build && node scripts/copy-legal-files.mjs && node scripts/test-privacy-boundary.mjs --require-dist",
    "preview": "vite preview",
    "lint": "eslint src scripts vite.config.js playwright.config.js tests/e2e",
    "add:event": "node scripts/add-event.mjs",
    "validate:personal": "node scripts/validate-personal-events.mjs",
    "test:e2e": "npm run build && playwright test",
    "add:event:interactive": "node scripts/add-event-interactive.mjs",
    "build:starter": "npm run build && node scripts/build-starter.mjs",
    "verify:public-release": "node scripts/test-privacy-boundary.mjs && node scripts/verify-public-release.mjs",
    "test": "node --test scripts/test-*.mjs",
    "check": "npm run lint && npm run build:events && npm run validate:personal && npm test"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.9.1",
    "globals": "^16.5.0",
    "vite": "^6.4.3"
  }
}
